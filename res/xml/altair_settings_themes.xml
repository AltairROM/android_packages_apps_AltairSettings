<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:lineage="http://schemas.android.com/apk/res/lineageos.platform"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/altair_settings_themes_title">

    <com.android.settingslib.widget.IllustrationPreference
        android:key="theme_settings_header"
        settings:searchable="false"
        app:lottie_rawRes="@raw/lottie_theme_settings" />

    <!-- Accent color -->
    <Preference
        android:key="theme_accent_color"
        android:title="@string/theme_accent_color_title"
        android:fragment="com.altair.settings.fragments.theme.AccentColorPicker" />

    <!-- Theme color style -->
    <ListPreference
        android:key="theme_color_style"
        android:title="@string/theme_color_style_title"
        android:entries="@array/theme_color_style_entries"
        android:entryValues="@array/theme_color_style_values"
        android:defaultValue="0" />

    <!-- Dark mode -->
    <com.android.settings.display.darkmode.DarkModePreference
        android:key="theme_dark_ui_mode"
        android:title="@string/dark_ui_mode"
        android:fragment="com.android.settings.display.darkmode.DarkModeSettingsFragment"
        android:widgetLayout="@null"
        settings:widgetLayout="@null"
        settings:controller="com.android.settings.display.DarkUIPreferenceController"
        settings:searchable="false" />

    <!-- Change wallpaper -->
    <com.android.settingslib.RestrictedPreference
        android:key="wallpaper"
        android:title="@string/wallpaper_settings_title"
        settings:keywords="@string/keywords_display_wallpaper"
        settings:useAdminDisabledSummary="true"
        settings:controller="com.android.settings.display.WallpaperPreferenceController">
    </com.android.settingslib.RestrictedPreference>

    <!-- Theme elements -->
    <PreferenceCategory
        android:key="theme_elements"
        android:title="@string/theme_elements_category">

        <!-- Themes -->
        <Preference
            android:key="custom_system_theme"
            android:title="@string/custom_system_theme_title"
            android:summary="@string/custom_system_theme_summary">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetPackage="com.android.axion.axthemestore"
                android:targetClass="com.android.axion.axthemestore.MainActivity" />
        </Preference>

        <!-- Font -->
        <com.altair.settings.preferences.FontsPickerPreference
            android:key="system_font"
            android:title="@string/theme_elements_font_title"
            android:summary="theme_customization_font_summary" />

        <!-- Icon shape -->
        <Preference
            android:key="android.theme.customization.adaptive_icon_shape"
            android:title="@string/theme_elements_icon_shape_title"
            android:fragment="com.altair.settings.fragments.theme.IconShapesPicker" />

        <!-- Navigation bar style -->
        <Preference
            android:key="android.theme.customization.navbar"
            android:title="@string/theme_elements_navbar_title"
            android:fragment="com.altair.settings.fragments.theme.NavbarStylesPicker" />

    </PreferenceCategory>

</PreferenceScreen>
