<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:lineage="http://schemas.android.com/apk/res/lineageos.platform"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/altair_settings_sound_title">

    <com.android.settingslib.widget.IllustrationPreference
        android:key="sound_settings_header"
        settings:searchable="false"
        app:lottie_rawRes="@raw/sound_illustration"/>

    <!-- Volume panel -->
    <PreferenceCategory
        android:key="volume_panel_category"
        android:title="@string/volume_panel_title" >

        <!-- Volume panel position -->
        <lineageos.preference.LineageSecureSettingListPreference
            android:key="volume_panel_on_left"
            android:title="@string/volume_panel_position_title"
            android:summary="%s"
            android:entries="@array/volume_panel_position_entries"
            android:entryValues="@array/volume_panel_position_values" />

        <!-- Volume panel dismiss timeout -->
        <com.lineage.support.preferences.SecureSettingSeekBarPreference
            android:key="volume_dialog_dismiss_timeout"
            android:title="@string/volume_dialog_timeout_title"
            android:defaultValue="3000"
            android:max="10000"
            settings:min="1000"
            settings:interval="500"
            settings:units="@string/unit_milliseconds" />

        <!-- Volume panel haptic feedback -->
        <com.lineage.support.preferences.SecureSettingSwitchPreference
            android:key="volume_dialog_haptic_feedback"
            android:title="@string/volume_dialog_haptic_feedback_title"
            android:defaultValue="true" />

        <!-- Show per-app volume button in volume dialog -->
        <com.lineage.support.preferences.SystemSettingSwitchPreference
            android:key="show_app_volume"
            android:title="@string/app_volume_title"
            android:summary="@string/app_volume_summary"
            android:defaultValue="false" />
    </PreferenceCategory>

    <!-- In-call feedback -->
    <PreferenceCategory
        android:key="incall_vibration_category"
        android:title="@string/incall_vibration_category" >

        <com.lineage.support.preferences.SystemSettingSwitchPreference
            android:key="vibrate_on_connect"
            android:title="@string/incall_vibrate_connect_title"
            android:defaultValue="false" />

        <com.lineage.support.preferences.SystemSettingSwitchPreference
            android:key="vibrate_on_callwaiting"
            android:title="@string/incall_vibrate_call_wait_title"
            android:defaultValue="false" />

        <com.lineage.support.preferences.SystemSettingSwitchPreference
            android:key="vibrate_on_disconnect"
            android:title="@string/incall_vibrate_disconnect_title"
            android:defaultValue="false" />
    </PreferenceCategory>

    <!-- Miscellaneous -->
    <PreferenceCategory
        android:key="miscellaneous"
        android:title="@string/miscellaneous_category">

        <!-- Screenshot shutter sound  -->
        <com.lineage.support.preferences.SystemSettingSwitchPreference
            android:key="screenshot_shutter_sound"
            android:title="@string/screenshot_shutter_sound_title"
            android:summary="@string/screenshot_shutter_sound_summary"
            android:defaultValue="true" />

        <!-- Multi audio focus -->
        <com.lineage.support.preferences.SystemSettingSwitchPreference
            android:key="multi_audio_focus_enabled"
            android:title="@string/multi_audio_focus_title"
            android:summary="@string/multi_audio_focus_summary"
            android:defaultValue="false" />

        <!-- Adaptive Playback -->
        <Preference
            android:key="adaptive_playback_settings"
            android:title="@string/adaptive_playback_title"
            android:summary="@string/adaptive_playback_summary"
            android:fragment="com.altair.settings.fragments.sound.AdaptivePlayback" />

    </PreferenceCategory>

</PreferenceScreen>
